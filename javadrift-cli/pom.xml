<project xmlns="http://maven.apache.org/POM/4.0.0"><modelVersion>4.0.0</modelVersion>
 <parent><groupId>io.github.bohdaq</groupId><artifactId>javadrift</artifactId><version>0.3.0</version></parent>
 <artifactId>javadrift-cli</artifactId>
 <dependencies>
  <dependency><groupId>io.github.bohdaq</groupId><artifactId>javadrift-core</artifactId><version>${project.version}</version></dependency>
  <dependency><groupId>info.picocli</groupId><artifactId>picocli</artifactId><version>4.7.7</version></dependency>
  <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
 </dependencies>
 <build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.0</version>
 <executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration>
 <createDependencyReducedPom>false</createDependencyReducedPom><finalName>javadrift</finalName>
 <filters><filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.RSA</exclude><exclude>META-INF/*.DSA</exclude><exclude>module-info.class</exclude></excludes></filter></filters>
 <transformers><transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"><mainClass>io.github.bohdaq.javadrift.cli.Main</mainClass></transformer><transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/></transformers>
 </configuration></execution></executions></plugin></plugins></build>
</project>
